{
  "name": "Offshore Analyses",
  "short_name": "Offshore",
  "description": "Engineering analysis suite for offshore, marine, subsea and offshore renewable-energy structures. Works offline.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "./index.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f3f5f7",
